# Caddy gets and renews the Let's Encrypt certificate for $DOMAIN automatically.
# The app sends precompressed responses and its own security headers, so Caddy only proxies.

{$DOMAIN} {
	reverse_proxy 127.0.0.1:8080 {
		# While the app container restarts for an update, hold requests for up to 30 s
		# instead of returning 502, so visitors see a short delay, not an error.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
