# Copy to .env and fill in. Never commit .env.

# Your domain, without https:// or www. Its A record (and www's) must point at the VM's public IP.
DOMAIN=example.com

# Image built by .github/workflows/image.yml. Lowercase owner/repo.
# To roll back, set a tag such as ghcr.io/ss-s3/grantkosh:sha-<commit> and run `docker compose up -d`.
IMAGE=ghcr.io/ss-s3/grantkosh:latest

# Gemini key for the AI advisor. Leave empty to run the advisor in guided mode.
GEMINI_API_KEY=

GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
ADVISOR_PER_IP_LIMIT=12
ADVISOR_DAILY_LIMIT=400
