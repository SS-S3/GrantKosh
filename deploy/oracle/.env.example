# Copy to .env and fill in. Never commit .env.

# Your domain, without https:// or www. Its A record (and www's) must point at the VM's public IP.
DOMAIN=example.com

# Image built by .github/workflows/image.yml. Lowercase owner/repo.
# To roll back, set a tag such as ghcr.io/ss-s3/grantkosh:sha-<commit> and run `docker compose up -d`.
IMAGE=ghcr.io/ss-s3/grantkosh:latest

# Gemini keys for the AI advisor, separated by commas. Leave empty to run the advisor in guided mode.
GEMINI_API_KEYS=

GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS_FREE=gemini-3.5-flash-lite,gemini-2.5-flash-lite
ADVISOR_DAILY_LIMIT=2000

# Copy the rest from Vercel when you move (see DEPLOY.md, "Moving from Vercel to Oracle").
# Keep the same Upstash database so trial totals and monthly usage carry over.
PUBLIC_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_PLAN_ID=
CASHFREE_ENV=sandbox
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
