# Keys: https://aistudio.google.com/apikey  (free tier: Google may use prompts to improve its products)
# One key, or several separated by commas; requests rotate across them and fail over on quota errors.
GEMINI_API_KEYS=
# Tried in order; later models are used when an earlier one is rate-limited.
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS_FREE=gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Plan limits
ADVISOR_FREE_DAILY=2
ADVISOR_TRIAL_DAILY=5
ADVISOR_TRIAL_TOTAL=80
ADVISOR_PAID_DAILY=15
ADVISOR_PAID_MONTHLY=120
# Abuse and load guards (see DEPLOY.md, "Rate limits and cost")
ADVISOR_PER_IP_LIMIT=12
ADVISOR_IP_API_PER_MIN=60
ADVISOR_FREE_POOL_DAILY=300
ADVISOR_DAILY_LIMIT=2000
ADVISOR_GLOBAL_RPM=60
ADVISOR_QUEUE_WAIT_MS=20000
ADVISOR_CACHE_TTL_S=21600
# Sign-in (Clerk). The web build reads VITE_CLERK_PUBLISHABLE_KEY.
# CLERK_SECRET_KEY=
# Subscriptions (Cashfree). See DEPLOY.md.
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_PLAN_ID=
# CASHFREE_ENV=sandbox
# PUBLIC_URL=https://grantkosh.example
# Set when running behind a reverse proxy so per-IP limits use X-Forwarded-For
# TRUST_PROXY=1
PORT=8787
