# Free key: https://aistudio.google.com/apikey  (free tier: Google may use prompts to improve its products)
GEMINI_API_KEY=
# Tried in order; later models are used when an earlier one is rate-limited.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# Abuse/quota guards
ADVISOR_PER_IP_LIMIT=12
ADVISOR_FREE_DAILY=2
ADVISOR_PAID_DAILY=15
ADVISOR_FREE_POOL_DAILY=300
ADVISOR_DAILY_LIMIT=2000
# Sign-in (Clerk). The web build reads VITE_CLERK_PUBLISHABLE_KEY.
# CLERK_SECRET_KEY=
# Subscriptions (Cashfree). See DEPLOY.md.
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_PLAN_ID=
# CASHFREE_ENV=sandbox
# PUBLIC_URL=https://grantkosh.example
# Set when running behind a reverse proxy so per-IP limits use X-Forwarded-For
# TRUST_PROXY=1
PORT=8787
